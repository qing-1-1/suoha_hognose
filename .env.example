# Copy to .env for local Netlify development. Never commit the real API key.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
SUPABASE_URL=https://rseztlkuuxhtuttykabx.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Server only: private specimen photo delivery and purchase inquiries. Never include in browser files.
SUPABASE_SERVICE_ROLE_KEY=
INQUIRY_HASH_SECRET=

# Server-only administrator notifications. QQ SMTP uses TLS on port 465.
# Recipients come from active admin profiles joined to auth.users, not this sender.
ADMIN_EMAIL_ENABLED=false
SMTP_USER=m_aj@qq.com
SMTP_PASS=
# Public HTTPS origin used for admin links; Netlify URL is the fallback.
SITE_URL=

